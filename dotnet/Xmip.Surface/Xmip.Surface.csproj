<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What every .NET operator surface shares (ADR-0052): the surface over the
    binding, the snapshot surface, the scope tree and its rollup, how the
    runtime library is found, how a status is said in English, and how a TOML
    document is read. The cli, the two GUI hosts and the PowerShell module are
    thin faces over this, so a fix here reaches every surface at once.

    Beside the Operate model on purpose, in xmip-core-operate: what operates
    is no part of the ABI's definition (ADR-0058, clause 1; ADR-0052,
    amendment 2026-11-16), and ADR-0044's rule read for .NET puts code
    several surfaces need where they all already depend.

    Nothing here crosses the C ABI; Xmip.Operate calls it, through the
    declarations Xmip.Abi binds once. unsafe stays off. Target framework and
    the rest come from Directory.Build.props.
  -->

  <PropertyGroup>
    <RootNamespace>Xmip.Surface</RootNamespace>
    <AssemblyName>Xmip.Surface</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xmip.Operate\Xmip.Operate.csproj" />
  </ItemGroup>

  <!-- The one .NET writer to the operating system's log is internal: only
       ProgramAudit calls it, and its test proves it writes. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Xmip.Surface.Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- On disk the estate is TOML; JSON is reserved for memory and the wire.
         One reader, here, for a host's configuration and for a published
         snapshot alike. -->
    <PackageReference Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
  </ItemGroup>

  <!-- Runtime async (.NET 11): an async method is the runtime's own, not a
       compiler-written state machine. On Windows, the one build target for now;
       the cli's ahead-of-time build compiles it too. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

</Project>
